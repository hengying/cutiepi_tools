#!/bin/sh
# 把断电钩子复制进 initramfs。
#
# 为什么需要：这台机器开了 auto_initramfs=1，systemd-shutdown 在最后阶段
# 可能已经切换/卸载了根文件系统，此时只会执行 initramfs 里的
# /usr/lib/systemd/system-shutdown/ 脚本。装在 initramfs 里能保证两种情况下都执行。

PREREQ=""

prereqs() {
    echo "$PREREQ"
}

case "$1" in
    prereqs)
        prereqs
        exit 0
        ;;
esac

. /usr/share/initramfs-tools/hook-functions

SRC=/usr/lib/systemd/system-shutdown/cutiepi-hud-cutoff
DST="${DESTDIR}/usr/lib/systemd/system-shutdown"

if [ -f "$SRC" ]; then
    mkdir -p "$DST"
    cp -f "$SRC" "$DST/cutiepi-hud-cutoff"
    chmod 755 "$DST/cutiepi-hud-cutoff"
fi
