[Desktop Entry]
Type=Application
Name=CutiePi HUD
Name[zh_CN]=CutiePi 屏幕旋转与电池指示
Comment=Auto rotate the screen and show battery in the system tray
Comment[zh_CN]=根据摆放方向自动旋转屏幕，并在系统状态栏显示电池电量与充电状态
# 先按上次保存的屏幕方向转一次（让开机第一帧就是对的），再启动守护进程。
# 守护进程本身用 systemd 用户单元管理，这样 systemctl --user restart 能管到它，
# 日志也统一进 ~/cutiepi-hud.log。
Exec=sh -c '/usr/local/bin/cutiepi-hud rotate-apply-saved >/dev/null 2>&1; exec /usr/bin/systemctl --user start cutiepi-hud'
Terminal=false
NoDisplay=true
X-GNOME-Autostart-enabled=true
X-GNOME-Autostart-Delay=1
